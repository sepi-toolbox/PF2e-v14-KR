{
    "id": "PF2e-KR",
    "title": "Rutz's PF2e 한국어 번역 (v14 호환)",
    "description": "Pathfinder 2e의 공식 및 확장 콘텐츠를 포함한 한국어 번역 모듈입니다. (Rutz's PF2e-KR v1.4.5.5 기반, v14 호환 미러)<br>This is a Korean translation module for Pathfinder 2e, including core and expansion content. Ported from Rutz's PF2e-KR for Foundry VTT v14.",
    "version": "1.4.5.5-v14.1",
    "compatibility": {
        "minimum": "13",
        "verified": "14"
    },

    "styles": ["pf2e-kr.css"],

    "authors": [
    {
        "name": "Rutz (rutz179)"
    },
    {
        "name": "Sepi (v14 호환 포팅)",
        "url": "https://github.com/sepi-toolbox"
    }
    ],

    "esmodules": [
        "babele.js"
    ],
    "relationships": {
        "requires": [
            {
                "id": "babele",
                "type": "module"
            },
            {
                "id": "lib-wrapper",
                "type": "module"
            }
        ]
    },

    "languages": [ 

        {
        "lang": "ko",
        "name": "ko",
        "path": "lang/ko.json",
        "flags": {}
        },

        {
        "lang": "ko",
        "name": "re-ko",
        "path": "lang/re-ko.json",
        "flags": {}
        },

        {
        "lang": "ko",
        "name": "actions-ko",
        "path": "lang/action-ko.json",
        "flags": {}
        },

        {
        "lang": "ko",
        "name": "kingmaker-ko",
        "path": "lang/kingmaker-ko.json",
        "flags": {}
        }
    ],
    "url": "https://github.com/sepi-toolbox/PF2e-v14-KR",
    "manifest": "https://raw.githubusercontent.com/sepi-toolbox/PF2e-v14-KR/main/module.json",
    "download": "https://github.com/sepi-toolbox/PF2e-v14-KR/archive/refs/heads/main.zip"
}
